---
import Analytics from '@vercel/analytics/astro';
const { title, description = "Frontend Guide — practical explainers for real frontend developers" } = Astro.props;
---

<html lang="en">
  <head>
    <link rel="stylesheet" href="/src/styles/common.css" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <title>{title} | Frontend Guide</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <div class="wrapper">
      <header class="site-header">
        <a href="/" class="logo">Frontend Guide</a>
        <nav>
          <a href="/">Articles</a>
          <a href="/about">About</a>
        </nav>
      </header>

      <div class="layout">
        <main class="content">
          <slot />	
        </main>

        <aside class="sidebar">
          <h3>Categories</h3>
          <ul>
			<li><a href="/categories/react">React</a></li>
			<li><a href="/categories/css">CSS</a></li>
			<li><a href="/categories/javascript">JavaScript</a></li>
			<li><a href="/categories/career">Career</a></li>
			<li><a href="/categories/performance">Performance</a></li>
			<li><a href="/categories/accessibility">Accessibility</a></li>
		  </ul>
        </aside>
      </div>

      <footer class="site-footer">
        <p>&copy; 2026 Frontend Guide.</p>
		<p>Maddy. Frontend dev writing about the parts of React/CSS tutorials skip </p>
      </footer>
    </div>

    <style>
      .wrapper {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }
      .site-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.75rem 0;
        border-bottom: 1px solid #e5e5e5;
      }
      .logo {
		font-weight: 800;
		font-size: 1.6rem;
		color: #1a1a1a;
		text-decoration: none;
		letter-spacing: -0.02em;
	  }
      nav a {
        margin-left: 1.5rem;
        text-decoration: none;
        color: #555;
        font-size: 0.95rem;
      }
      nav a:hover { color: #4f46e5; }

      .layout {
        display: grid;
        grid-template-columns: 1fr 220px;
        gap: 2.5rem;
        padding: 2.5rem 0;
      }
      @media (max-width: 700px) {
        .layout { grid-template-columns: 1fr; }
      }

      .sidebar h3 {
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #999;
        margin-bottom: 0.75rem;
      }
      .sidebar ul { list-style: none; padding: 0; margin: 0; }
      .sidebar li {
        padding: 0.4rem 0;
        color: #555;
        font-size: 0.9rem;
        border-bottom: 1px solid #eee;
      }

      .site-footer {
        border-top: 1px solid #e5e5e5;
        padding: 1.5rem 0;
        color: #999;
        font-size: 0.85rem;
        text-align: center;
      }
    </style>
    <Analytics />
  </body>
</html>