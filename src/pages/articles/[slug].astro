---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { getReadTime } from '../../utils/readTime';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const readTime = getReadTime(article.body ?? '');
---

<Layout title={article.data.title} description={article.data.description}>
  <a href="/" class="back-link">← Back to all articles</a>

  <span class={`badge badge-${article.data.category.toLowerCase()}`}>{article.data.category}</span>
  <h1>{article.data.title}</h1>
  <p class="article-meta">{article.data.category} · {article.data.difficulty} · {readTime} min read</p>

  <div class="takeaway">
    <strong>Key takeaway:</strong> {article.data.coreTakeaway}
  </div>

  <article class="prose">
    <Content />
  </article>
</Layout>

<style>
  .back-link {
    display: inline-block;
    color: #666;
    text-decoration: none;
    font-size: 0.9rem;
    margin-bottom: 1.2rem;
  }
  .back-link:hover { color: #4f46e5; }

  h1 {
    font-size: 2.1rem;
    margin: 0.6rem 0 0.3rem;
  }
  .article-meta {
    color: #999;
    font-size: 0.9rem;
    margin: 0 0 1.5rem;
  }

  .takeaway {
    background: #eef2ff;
    border-left: 4px solid #4f46e5;
    padding: 1rem 1.2rem;
    border-radius: 6px;
    margin-bottom: 2rem;
    font-size: 0.95rem;
  }

  .badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.2rem 0.6rem;
    border-radius: 20px;
    background: #eef2ff;
    color: #4f46e5;
  }
  .badge-css { background: #fdf2f8; color: #db2777; }
  .badge-javascript { background: #fefce8; color: #ca8a04; }
  .badge-career { background: #f0fdf4; color: #16a34a; }
  .badge-performance { background: #fff7ed; color: #ea580c; }
  .badge-accessibility { background: #f5f3ff; color: #7c3aed; }

  .prose {
    font-size: 1.05rem;
    line-height: 1.75;
    color: #222;
  }
  .prose :global(h2) {
    font-size: 1.4rem;
    margin: 2rem 0 0.8rem;
  }
  .prose :global(p) {
    margin: 0 0 1.2rem;
  }
  .prose :global(pre) {
    background: #1e1e2e;
    color: #e5e5e5;
    padding: 1.2rem;
    border-radius: 10px;
    overflow-x: auto;
    max-width: 100%;
    font-size: 0.88rem;
    margin: 1.2rem 0;
  }
  .prose :global(code) {
    font-family: 'SF Mono', Consolas, monospace;
  }
  .prose :global(p code) {
    background: #f0f0f0;
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-size: 0.9em;
    color: #d63384;
  }
</style>  