---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const articles = await getCollection('articles');
const sorted = articles.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<Layout title="Home">
  <section class="hero">
    <h1>Frontend Guide</h1>
    <p>Practical, honest explainers for real frontend developers — the parts of React, CSS, and JS that most tutorials skip.</p>
  </section>

  <div class="article-grid">
    {sorted.map((article) => (
      <a href={`/articles/${article.id}`} class="card">
        <span class={`badge badge-${article.data.category.toLowerCase()}`}>{article.data.category}</span>
        <h2>{article.data.title}</h2>
        <p>{article.data.description}</p>
        <div class="card-meta">
          <span>{article.data.difficulty}</span>
          <span>·</span>
          <span>{article.data.publishDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
        </div>
      </a>
    ))}
  </div>
</Layout>

<style>
  .hero {
    padding: 1rem 0 2rem;
  }
  .hero h1 {
    font-size: 2.4rem;
    margin-bottom: 0.5rem;
  }
  .hero p {
    color: #666;
    font-size: 1.05rem;
    max-width: 560px;
  }
</style>