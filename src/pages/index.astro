---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const articles = await getCollection('articles');
const sorted = articles.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<Layout title="Home">
  <section class="hero">
    <h1>Frontend Guide</h1>
    <p>Practical, honest explainers for real frontend developers — the parts of React, CSS, and JS that most tutorials skip.</p>
  </section>

  <div class="article-grid">
    {sorted.map((article) => (
      <a href={`/articles/${article.id}`} class="card">
        <span class={`badge badge-${article.data.category.toLowerCase()}`}>{article.data.category}</span>
        <h2>{article.data.title}</h2>
        <p>{article.data.description}</p>
        <div class="card-meta">
          <span>{article.data.difficulty}</span>
          <span>·</span>
          <span>{article.data.publishDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
        </div>
      </a>
    ))}
  </div>
</Layout>

<style>
  .hero {
    padding: 1rem 0 2rem;
  }
  .hero h1 {
    font-size: 2.4rem;
    margin-bottom: 0.5rem;
  }
  .hero p {
    color: #666;
    font-size: 1.05rem;
    max-width: 560px;
  }

  .article-grid {
    display: grid;
    gap: 1.25rem;
  }

  .card {
    display: block;
    padding: 1.5rem;
    background: #fff;
    border: 1px solid #e5e5e5;
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.15s ease, transform 0.15s ease, border-color 0.15s ease;
  }
  .card:hover {
    box-shadow: 0 4px 16px rgba(0,0,0,0.06);
    transform: translateY(-2px);
    border-color: #d4d4d4;
  }
  .card h2 {
    font-size: 1.25rem;
    margin: 0.6rem 0 0.4rem;
  }
  .card p {
    color: #666;
    margin: 0;
    font-size: 0.95rem;
  }
  .card-meta {
    margin-top: 0.9rem;
    font-size: 0.82rem;
    color: #999;
    display: flex;
    gap: 0.4rem;
  }

  .badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.2rem 0.6rem;
    border-radius: 20px;
    background: #eef2ff;
    color: #4f46e5;
  }
  .badge-css { background: #fdf2f8; color: #db2777; }
  .badge-javascript { background: #fefce8; color: #ca8a04; }
  .badge-career { background: #f0fdf4; color: #16a34a; }
  .badge-performance { background: #fff7ed; color: #ea580c; }
  .badge-accessibility { background: #f5f3ff; color: #7c3aed; }
</style>